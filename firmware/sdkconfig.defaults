# Copyright 2026 CEMAXECUTER LLC
#
# Elecrow ESP32 WiFi HaLow Module: ESP32-S3, 16 MB flash, 8 MB octal PSRAM,
# Quectel FGH100M (MM6108). Pins are from docs/BOARD.md.

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms ticks: the spectrum task yields between snapshots without losing 10 ms.
CONFIG_FREERTOS_HZ=1000

# HaLow module
CONFIG_MM_RESET_N=8
CONFIG_MM_WAKE=9
CONFIG_MM_BUSY=7
CONFIG_MM_SPI_SCK=4
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=5
CONFIG_MM_SPI_CS=2
CONFIG_MM_SPI_IRQ=6
CONFIG_MM_CHIP_MM6108=y
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.bin"
CONFIG_HALOW_COUNTRY_CODE="US"

CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Always run a full PHY calibration and never store it: the stock
# firmware's calibration record in NVS stays as it was.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Spectrum FFTs up to 8192 points (a 16384-pair snapshot holds two).
CONFIG_DSP_MAX_FFT_SIZE_8192=y
